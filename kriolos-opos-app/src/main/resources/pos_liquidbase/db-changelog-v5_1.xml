<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.8.xsd">

    <!-- Antigravity - Agregar campos metadata de producto para mayor detalle (Lote, Modelo, Color, Voltaje, NoSerie) -->
    <changeSet author="antigravity" id="20260412-01">
        <addColumn tableName="products">
            <column name="lote" type="VARCHAR(255)"/>
            <column name="modelo" type="VARCHAR(255)"/>
            <column name="color" type="VARCHAR(255)"/>
            <column name="voltaje" type="VARCHAR(255)"/>
            <column name="noserie" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
